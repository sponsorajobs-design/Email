# ==============================================================================
# SPONSORAJOBS LOCAL MATCHING & EMAIL ENGINE CONFIGURATION
# ==============================================================================
# IMPORTANT: This application is strictly local. Do NOT deploy to Vercel.
# Supabase credentials are used READ-ONLY. The application never writes to production.
# ==============================================================================

# Application Environment (development, production)
APP_ENV=development
SECRET_KEY=sponsorajobs-local-secret-change-in-production-random-key-32chars
API_PORT=8000
API_HOST=127.0.0.1
ADMIN_PASSWORD_HASH=

# Local SQLite Database (can be switched to PostgreSQL later without redesign)
LOCAL_DATABASE_URL=sqlite+aiosqlite:///./data/sponsorajobs_local.db

# Production Supabase Read-Only Connection
# Leave empty for mock/offline demonstration mode
SUPABASE_URL=
SUPABASE_READONLY_KEY=

# Supabase Table Names & Field Mappings (Configurable adapter layer)
SUPABASE_SUBSCRIBER_TABLE=subscribers
SUPABASE_JOB_TABLE=jobs

# SMTP Sending Configuration
SMTP_HOST=mail.sponsorajobs.com
SMTP_PORT=587
SMTP_USERNAME=hr@sponsorajobs.com
SMTP_PASSWORD=
SMTP_USE_TLS=true
FROM_NAME=SponsorAJobs
FROM_EMAIL=hr@sponsorajobs.com

# Safety & Testing Modes
# When DRY_RUN=true, no actual emails are sent over the network
DRY_RUN=true

# When EMAIL_TEST_MODE=true, all emails are redirected to TEST_EMAIL_ADDRESS
EMAIL_TEST_MODE=true
TEST_EMAIL_ADDRESS=test-admin@sponsorajobs.com

# Matching Engine Weights (Total = 100)
MATCH_THRESHOLD=70
ROLE_MATCH_WEIGHT=35
SKILLS_MATCH_WEIGHT=30
EXPERIENCE_MATCH_WEIGHT=20
LOCATION_MATCH_WEIGHT=10
RECENCY_MATCH_WEIGHT=5

# Job URL Verification Settings
JOB_URL_VERIFY_TTL_HOURS=6
JOB_URL_VERIFY_TIMEOUT_SECONDS=10
JOB_URL_VERIFY_MAX_RETRIES=2

# Sending Rate Controls (Respect provider limits)
EMAIL_RATE_PER_MINUTE=10
EMAIL_MAX_CONCURRENCY=2
EMAIL_MAX_RETRIES=3

# Campaign Limits
MAX_CAMPAIGN_SIZE=100
DEFAULT_BATCH_SIZE=25

# Unsubscribe base URL (Points to local or public unsubscribe handler)
UNSUBSCRIBE_BASE_URL=http://127.0.0.1:8000/unsubscribe
